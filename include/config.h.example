#pragma once

// WiFi credentials — the only build-time config still needed. Everything
// else (conductor URL, pairing, pin mapping) is set in the web UI once
// the device is on the network, and persists in flash.
#define WIFI_SSID     "your-ssid"
#define WIFI_PASS     "your-password"

// Optional: pre-fill the conductor URL in the setup page.
#define DEFAULT_SERVER_URL   ""
#define DEFAULT_DEVICE_NAME  "Batton"
